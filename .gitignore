# Composer-managed directories — regenerated by `composer install`
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/libraries/

# Drupal files directory (user uploads)
/web/sites/default/files/

# Sensitive / environment-specific settings
/web/sites/default/settings.php
/web/sites/default/settings.local.php
/web/sites/default/settings.ddev.php

# DDEV — keep config.yaml (shared dev setup), ignore generated files
/.ddev/apache/
/.ddev/commands/web/
/.ddev/db-build/
/.ddev/homeadditions/
/.ddev/mysql/
/.ddev/addon-metadata/
/.ddev/db_snapshots/
/.ddev/*.yaml
!/.ddev/config.yaml

# Archives and local backups
*.tar.gz
*.sql
*.sql.gz
*.zip

# Claude Code internals
/.claude/
/web/.claude/

# Drupal upstream documentation (not project-specific)
/web/INSTALL.txt
/web/README.md
/web/example.gitignore
/web/modules/README.txt
/web/themes/README.txt
/web/sites/README.txt
/web/profiles/README.txt

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
