{#
/**
 * @file
 * Sandes Ancestry theme: block--system-branding-block.html.twig
 *
 * Overrides the core system branding block to match the sandes_ancestry
 * header styling.
 *
 * Available variables:
 *   - site_logo:   Logo URL (only if enabled in block config).
 *   - site_name:   Site name string (only if enabled in block config).
 *   - site_slogan: Site slogan string (only if enabled in block config).
 */
#}
<div class="site-branding">
  {% if site_logo %}
    <div class="site-logo">
      <a href="{{ path('<front>') }}" title="{{ 'Home'|t }}" rel="home">
        <img src="{{ site_logo }}" alt="{{ site_name }}" />
      </a>
    </div>
  {% endif %}
  {% if site_name or site_slogan %}
    <div class="site-branding__text">
      {% if site_name %}
        <div class="site-name">
          <a href="{{ path('<front>') }}" title="{{ 'Home'|t }}" rel="home">
            {{ site_name }}
          </a>
        </div>
      {% endif %}
      {% if site_slogan %}
        <div class="site-slogan">{{ site_slogan }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>
