{#
/**
 * @file
 * Sandes Ancestry theme: breadcrumb.html.twig
 *
 * Available variables:
 *   - breadcrumb: array of items, each with:
 *       - url  (string, may be empty for the current page)
 *       - text (string)
 */
#}
{% if breadcrumb %}
  <nav class="sa-breadcrumb" aria-label="{{ 'Breadcrumb'|t }}">
    <ol class="sa-breadcrumb__list">
      {% for item in breadcrumb %}
        <li class="sa-breadcrumb__item">
          {%- if item.url -%}
            <a class="sa-breadcrumb__link" href="{{ item.url }}">{{ item.text }}</a>
          {%- else -%}
            <span class="sa-breadcrumb__current" aria-current="page">{{ item.text }}</span>
          {%- endif -%}
          {%- if not loop.last -%}
            <span class="sa-breadcrumb__sep" aria-hidden="true">›</span>
          {%- endif -%}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
