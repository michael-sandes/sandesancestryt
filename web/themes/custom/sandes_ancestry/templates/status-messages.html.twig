{#
/**
 * @file
 * Sandes Ancestry theme: status-messages.html.twig
 *
 * Adds .messages and .messages--{type} classes so the theme CSS can style
 * status, warning, and error messages. Drupal 11 core removed these classes
 * from its default template; we add them back here.
 *
 * Available variables:
 *   - message_list:    Keyed by type (status, warning, error); value is a
 *                      list of message strings.
 *   - status_headings: Human-readable label for each type.
 *   - attributes:      HTML attributes for the inner message div (may include
 *                      aria-label, role, etc. from core preprocess).
 */
#}
<div data-drupal-messages>
  {% for type, messages in message_list %}
    <div{{ attributes
      .setAttribute('role', type == 'error' ? 'alert' : 'contentinfo')
      .setAttribute('aria-label', status_headings[type])
      .addClass('messages', 'messages--' ~ type) }}>
      {% if status_headings[type] %}
        <h2 class="visually-hidden">{{ status_headings[type] }}</h2>
      {% endif %}
      {% if messages|length > 1 %}
        <ul class="messages__list">
          {% for message in messages %}
            <li class="messages__item">{{ message }}</li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="messages__item">{{ messages|first }}</p>
      {% endif %}
    </div>
  {% endfor %}
</div>
