{#
/**
 * @file
 * Sandes Ancestry theme: menu--main.html.twig
 *
 * Renders the Main Navigation menu with theme-owned classes so CSS
 * cannot be overridden by Drupal core or stable9 list styles.
 *
 * Available variables:
 *   - items: array of menu items, each containing:
 *       - title      : link text
 *       - url        : URL object (use url|render or path())
 *       - attributes : HTML attributes for the <li>
 *       - in_active_trail : bool — ancestor of the current page
 *       - is_expanded     : bool — has visible children
 *       - is_collapsed    : bool — has hidden children
 *       - below      : array of child menu items (same structure)
 *   - menu_name  : machine name of this menu ('main')
 *   - attributes : attributes for the root <ul>
 */
#}
{% import _self as menus %}

{#
  Recursive macro — called for the top level and again for each
  dropdown. `depth` starts at 0 for the root.
#}
{% macro render_menu(items, depth) %}
  {% import _self as menus %}
  {% if items %}
    <ul class="sa-nav__list sa-nav__list--depth-{{ depth }}">
      {% for item in items %}
        {%
          set item_classes = [
            'sa-nav__item',
            item.in_active_trail ? 'sa-nav__item--active-trail',
            item.is_expanded    ? 'sa-nav__item--expanded',
            item.is_collapsed   ? 'sa-nav__item--collapsed',
            item.below          ? 'sa-nav__item--has-children',
          ]|filter(v => v)
        %}
        <li{{ item.attributes.addClass(item_classes) }}>
          <a href="{{ item.url }}"
             class="sa-nav__link{% if item.in_active_trail %} sa-nav__link--active{% endif %}"
             {% if item.below %}aria-haspopup="true" aria-expanded="false"{% endif %}>
            {{- item.title -}}
          </a>
          {% if item.below %}
            {{ menus.render_menu(item.below, depth + 1) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}

<nav class="sa-nav" aria-label="{{ 'Main navigation'|t }}">
  {{ menus.render_menu(items, 0) }}
</nav>
