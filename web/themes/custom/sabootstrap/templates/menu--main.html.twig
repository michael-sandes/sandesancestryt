{#
/**
 * @file
 * SABootstrap theme: menu--main.html.twig
 *
 * Renders the main menu as Bootstrap navbar-nav links.
 * Top-level items with children become Bootstrap dropdowns.
 */
#}

{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul class="navbar-nav">
    {% else %}
      <ul class="dropdown-menu">
    {% endif %}

    {% for item in items %}
      {% set has_children = item.below %}
      <li class="nav-item{{ has_children ? ' dropdown' : '' }}">
        {% if has_children %}
          <a href="{{ item.url }}"
             class="nav-link dropdown-toggle"
             role="button"
             data-bs-toggle="dropdown"
             aria-expanded="false"
             {{ item.in_active_trail ? 'aria-current="page"' }}>
            {{ item.title }}
          </a>
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% else %}
          <a href="{{ item.url }}"
             class="nav-link{{ item.in_active_trail ? ' active' }}"
             {{ item.in_active_trail ? 'aria-current="page"' }}>
            {{ item.title }}
          </a>
        {% endif %}
      </li>
    {% endfor %}

    </ul>
  {% endif %}
{% endmacro %}
