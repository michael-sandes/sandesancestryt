{#
/**
 * @file
 * SABootstrap theme: breadcrumb.html.twig
 *
 * Renders as a Bootstrap breadcrumb nav.
 */
#}

{% if breadcrumb %}
  <nav aria-label="{{ 'Breadcrumb'|t }}">
    <ol class="breadcrumb mb-0">
      {% for item in breadcrumb %}
        <li class="breadcrumb-item{{ loop.last ? ' active' }}">
          {% if item.url and not loop.last %}
            <a href="{{ item.url }}">{{ item.text }}</a>
          {% else %}
            {{ item.text }}
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
