{#
/**
 * @file
 * Royal Heritage theme: node.html.twig
 *
 * Available variables:
 *   - node, view_mode, teaser, page, readmore
 *   - label, content, author_name, author_picture
 *   - date, node_url, attributes, content_attributes, author_attributes
 *   - title_prefix, title_suffix, metadata
 */
#}

{% set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  node.isPromoted() ? 'node--promoted',
  node.isSticky() ? 'node--sticky',
  not node.isPublished() ? 'node--unpublished',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
] %}

<article{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  {% if not page %}
    <h2 class="node__title">
      <a href="{{ node_url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if display_submitted %}
    <div class="node__meta">
      {{ author_picture }}
      <span class="node__submitted">
        {% trans %}
          Posted by {{ author_name }} on {{ date }}
        {% endtrans %}
      </span>
      {{ metadata }}
    </div>
  {% endif %}

  <div{{ content_attributes.addClass('node__content') }}>
    {{ content }}
  </div>

</article>
