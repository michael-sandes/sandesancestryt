{#
/**
 * @file
 * Royal Heritage theme: menu-local-task.html.twig
 *
 * Renders a single local task tab item.
 *
 * Available variables:
 *   - link      : render array for the tab link
 *   - is_active : bool — whether this is the currently active tab
 *   - attributes: HTML attributes for the <li>
 */
#}
<li{{ attributes.addClass(
  'rh-tabs__item',
  is_active ? 'rh-tabs__item--active'
) }}>
  {{ link }}
</li>
