<?php

/**
 * @file
 * claro_custom.theme
 *
 * Preprocess functions and theme hooks for the Claro Custom subtheme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function claro_custom_preprocess_html(array &$variables): void {
  // Add a body class based on the current route for targeted CSS overrides.
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name) {
    $variables['attributes']['class'][] = 'route--' . str_replace('.', '-', $route_name);
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function claro_custom_preprocess_page(array &$variables): void {
  // Make the site name available as a standalone variable.
  $variables['site_name'] = \Drupal::config('system.site')->get('name');
}

/**
 * Implements hook_form_alter().
 *
 * Use this to make global tweaks to admin forms.
 */
function claro_custom_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Example: add a custom class to all admin forms.
  // $form['#attributes']['class'][] = 'claro-custom-form';
}
